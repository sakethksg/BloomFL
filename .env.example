# BloomFL — root .env.example
# Copy to .env and adjust for your deployment.

# ── API Server ──────────────────────────────────────────────────────────────
API_PORT=8000

# ── Frontend ────────────────────────────────────────────────────────────────
# URL of the FastAPI backend as seen from the browser
# For local dev: http://localhost:8000
# For Docker Compose: http://api:8000 (container-to-container)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── BloomFL Node (shared with API for metrics_dir) ──────────────────────────
BLOOMFL_METRICS_DIR=./metrics
BLOOMFL_KEY_STORAGE_DIR=./keys
BLOOMFL_DATA_DIR=./data

BLOOMFL_TRANSPORT=tcp
BLOOMFL_GOSSIP_INTERVAL_SECONDS=10
BLOOMFL_TRAIN_EPOCHS_PER_ROUND=1
BLOOMFL_ADAPTATION_ENABLED=true
BLOOMFL_AGGREGATION_STRATEGY=weighted_avg

# ── Simulation defaults ─────────────────────────────────────────────────────
BLOOMFL_SIM_BASE_PORT=50100
BLOOMFL_SIM_NETWORK_DELAY_MEAN_MS=0
BLOOMFL_SIM_NETWORK_DELAY_STD_MS=0
BLOOMFL_SIM_FAILURE_PROBABILITY=0.0
